NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/smart_college
SESSION_MONGODB_URI=mongodb://127.0.0.1:27017/smart_college_sessions
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_NAME=smart_college.sid
SESSION_MAX_AGE=86400000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
SEED_ADMIN_NAME=College Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
